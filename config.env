# ============================================================
# config.env — Configurações da automação GraphAccount Pro
# ============================================================
# Edite este arquivo antes de rodar o pipeline pela primeira vez.
# NÃO commite este arquivo no Git (já está no .gitignore).
# Linhas começando com # são comentários — ignoradas pelo sistema.
# ============================================================


# ── PASTAS DE ENTRADA ────────────────────────────────────────
# Pasta raiz onde ficam os dados do fechamento mensal.
# Dentro dela devem existir as subpastas abaixo.
# Exemplo Windows: C:\dados\SCG-2026
PASTA_ENTRADA=SCG-26 - Copia

# Nome das subpastas dentro de PASTA_ENTRADA
SUBPASTA_CGR=RPV - Recuperação do Preço de Venda/CGR
SUBPASTA_RET=RET - Recuperação de Encargos de Transporte
SUBPASTA_CGF=RPV - Recuperação do Preço de Venda/CGF
SUBPASTA_RP=RP - Recuperação de Penalidades
SUBPASTA_PMPV=PMPV

# Estrutura esperada:
#   dados/entrada/
#     ├── CGR/    ← XMLs das NF-e e CT-e (Auditoria)
#     ├── RET/    ← PDFs de encargos de transporte
#     ├── CGF/    ← Excels de volume faturado/cancelado/devoluções
#     ├── RP/     ← PDFs de penalidades (Receita/ e Despesa/ como subpastas)
#     └── PMPV/   ← Excel de Memória de Cálculo


# ── PASTA DE SAÍDA ───────────────────────────────────────────
# Onde o Excel final será salvo após o pipeline rodar.
PASTA_SAIDA=saida


# ── CONFIGURAÇÕES DE CÁLCULO ─────────────────────────────────
# Nome da empresa padrão (usado na Auditoria XML)
EMPRESA_PADRAO=COPERGÁS

# Valor da Conta Gráfica para o cálculo do PMPV (em R$/m³)
# Negativo = desconto. Exemplo: -0.0210
PMPV_VALOR_CG=0.0

# Memória de Cálculo por trimestre regulatório (Nov-Jan / Fev-Abr / Mai-Jul / Ago-Out)
# O pipeline seleciona automaticamente o arquivo correto para cada mês.
PMPV_ARQUIVO_NOV_JAN=Excel/Memória de Cálculo.xlsx
PMPV_ARQUIVO_FEV_ABR=Memória de cálculo (1).xlsx
PMPV_ARQUIVO_MAI_JUL=Memória de Cálculo - Custo Médio Ponderado.xlsx

# Mapeamento de colunas do Excel do CGF
# (só altere se os nomes das colunas no seu Excel forem diferentes)
CGF_COL_VOLUME_FAT=Volume Faturado
CGF_COL_CONSUMO=Produto
CGF_VAL_CONSUMO=consumo proprio
CGF_COL_CANCELADAS=Volume Canc/Deneg
CGF_COL_DEVOLUCOES=Volume Devolução


# ── NOTIFICAÇÃO POR E-MAIL (OPCIONAL, CUSTO ZERO) ────────────
# Deixe em branco para desativar o e-mail.
# O pipeline funciona normalmente mesmo sem e-mail configurado.
#
# Como configurar o Gmail:
#   1. Acesse myaccount.google.com → Segurança
#   2. Ative "Verificação em 2 etapas"
#   3. Ainda em Segurança → Senhas de app → crie senha para "GraphAccount"
#   4. Cole a senha de 16 caracteres abaixo (com espaços, como aparece)
#
EMAIL_REMETENTE=
EMAIL_SENHA_APP=
EMAIL_DESTINATARIO=

# Servidor SMTP (não precisa mudar para Gmail)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
